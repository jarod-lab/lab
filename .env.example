# Copy to .env (gitignored). mise loads it into your shell, so pnpm scripts, drizzle-kit and tests see it.
# Validated in packages/env — keep in sync.
DATABASE_URL=postgres://user:pass@localhost:5432/starter
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
EMAIL_FROM="Starter <auth@example.com>"
# Optional: syncs signups to Wraps contacts
WRAPS_API_KEY=
# Optional: social sign-in. Each button appears only when both values are set. The callback URL is
# ${BETTER_AUTH_URL}/api/auth/callback/github (or /callback/google).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: port for apps/api (defaults to the port in BETTER_AUTH_URL, then 3000).
# Under `pnpm dev`, portless sets PORT and PORTLESS_URL itself; apps/api then uses PORTLESS_URL as its URL.
PORT=
# Optional: fatal|error|warn|info|debug|trace|silent (default info; silent under test)
LOG_LEVEL=
# Requests per organization per UTC day (metering). Unclaimed = the owner has not verified their email.
ORG_DAILY_REQUEST_LIMIT=10000
UNCLAIMED_ORG_DAILY_REQUEST_LIMIT=500
# Set to true only behind a proxy that overwrites X-Forwarded-For (signup rate limits use the client IP).
TRUST_PROXY=false
# Optional: vendors GET /status reports, from their own status pages (/health pings nothing). Comma-separated
# Name=https://status.example.com (an Atlassian Statuspage) or aws:<service>@<region> (AWS Health), e.g.
# STATUS_PROVIDERS=Vercel=https://www.vercel-status.com,aws:ses@us-east-1
STATUS_PROVIDERS=
# Optional: built web app to serve from this API origin (run `pnpm --filter @starter/web build` first).
WEB_DIST_DIR=
# Dev only: where apps/web's vite dev server proxies API calls (default http://localhost:3000).
API_URL=
# e2e only: model credential for `pnpm e2e` agent steps (Vercel AI Gateway). See e2e/README.md.
AI_GATEWAY_API_KEY=
