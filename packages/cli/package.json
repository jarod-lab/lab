{
  "name": "@starter/cli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "starter": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "starter": "node dist/bin.js",
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"#!/usr/bin/env node\" --outfile=dist/bin.js",
    "typecheck": "tsc",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@starter/sdk": "workspace:*"
  },
  "devDependencies": {
    "@starter/cli": "link:.",
    "@starter/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "^0.28.2",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
