  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@starter/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
