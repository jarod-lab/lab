{
  "openapi": "3.1.0",
  "info": {
    "title": "Test API",
    "version": "1.0.0",
    "description": "A test API."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/v1/whoami": {
      "get": {
        "operationId": "whoami",
        "summary": "Show the caller, its organization, permissions and usage",
        "description": "Returns the organization this credential acts for, who is acting (a user or an API key), how it authenticated, its permission grants (a request is allowed when one grant covers all of it), today's usage against the daily limit, and whether the owner has claimed the account (verified the email). Call this first to check a credential.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "organizationId": {
                      "type": "string"
                    },
                    "actor": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "user",
                            "apiKey"
                          ]
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    "via": {
                      "type": "string"
                    },
                    "grants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "day": {
                          "type": "string",
                          "description": "The UTC day the counter covers (YYYY-MM-DD)"
                        },
                        "total": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Requests so far today, including this one"
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Requests allowed per day for this organization"
                        }
                      },
                      "required": [
                        "day",
                        "total",
                        "limit"
                      ],
                      "additionalProperties": false
                    },
                    "claimed": {
                      "type": "boolean",
                      "description": "False while the owner's email is unverified (lower limit)"
                    }
                  },
                  "required": [
                    "organizationId",
                    "actor",
                    "via",
                    "grants",
                    "usage",
                    "claimed"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or over quota. Wait for the Retry-After header before retrying.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          },
          {
            "bearer": []
          },
          {
            "oauth2": []
          }
        ],
        "x-required-permissions": [],
        "x-agent-hints": {
          "readOnly": true,
          "idempotent": true
        }
      }
    },
    "/v1/signup": {
      "post": {
        "operationId": "signup",
        "summary": "Create an agent account without signing in",
        "description": "Creates a personal organization, an API key with project permissions, and sends one email to the address to claim the account. Send it with no credentials: this is the only operation that needs none. Use the returned apiKey straight away, as x-api-key or a Bearer token. The key is temporary: it stops working when the person claims the account by opening the emailed link, since whoever called signup holds it. Tell them that. After the claim, calls with it get UNAUTHORIZED; sign in with the device grant (POST /api/auth/device/code, which the person approves at /device). Until the claim the organization has a lower daily request limit (see limits). Limits: 5 signups per client IP per hour and 20 per email domain per day.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "description": "Address that claims the account; one claim email is sent to it"
                  },
                  "name": {
                    "description": "Display name",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "email"
                ]
              },
              "example": {
                "email": "agent@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "organizationId": {
                      "type": "string"
                    },
                    "apiKey": {
                      "type": "string",
                      "description": "Shown once. Stores project read, create, update and delete."
                    },
                    "claimUrlSentTo": {
                      "type": "string"
                    },
                    "apiKeyEndsWhenClaimed": {
                      "type": "boolean",
                      "const": true,
                      "description": "apiKey stops working once the person claims the account; then use the device grant"
                    },
                    "limits": {
                      "type": "object",
                      "properties": {
                        "requestsPerDay": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Until the email is verified"
                        }
                      },
                      "required": [
                        "requestsPerDay"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "organizationId",
                    "apiKey",
                    "claimUrlSentTo",
                    "apiKeyEndsWhenClaimed",
                    "limits"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or over quota. Wait for the Retry-After header before retrying.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "x-required-permissions": []
      }
    },
    "/v1/projects": {
      "get": {
        "operationId": "list_projects",
        "summary": "List the organization's projects",
        "description": "Returns the organization's projects, oldest first, one page at a time. Pass nextCursor back as cursor to get the next page; it is null on the last page. Use the ids with delete_project.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "createdAt"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "projects",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or over quota. Wait for the Retry-After header before retrying.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          },
          {
            "bearer": []
          },
          {
            "oauth2": [
              "read"
            ]
          },
          {
            "oauth2": [
              "write"
            ]
          }
        ],
        "x-required-permissions": [
          "project:read"
        ],
        "x-agent-hints": {
          "readOnly": true,
          "idempotent": true
        }
      },
