{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "storybook-static/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "@starter/api-app#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/routeTree.gen.ts"]
    },
    "@starter/api-app#test:coverage": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/routeTree.gen.ts"],
      "outputs": ["coverage/**"]
    }
  }
}
