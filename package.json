{
  "name": "starter",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "portless",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "e2e run",
    "baseline": "baseline scan .",
    "format": "biome format --write .",
    "init-project": "node scripts/init-project.mjs",
    "test:coverage": "turbo run test:coverage",
    "format:check": "biome format .",
    "prepare": "lefthook install",
    "storybook": "pnpm --filter @starter/ui storybook",
    "stories": "node scripts/generate-stories.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@gdp-ts/core": "^0.1.0",
    "@shadcn/lint": "^0.2.0",
    "code-baseline": "^1.6.0",
    "e2e": "^0.17.0",
    "lefthook": "^2.1.16",
    "oxlint": "^1.87.0",
    "portless": "^0.15.7",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
