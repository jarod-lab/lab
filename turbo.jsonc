{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "storybook-static/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    // Test tasks have no `^test` dependency, so a workspace dependency's source is NOT in their hash
    // (checked with `turbo run test --filter=@starter/web --dry-run=json`: a probe edit to
    // packages/auth/src/access.ts left the @starter/web#test hash unchanged). The apps' tests import
    // those packages, so every package's src is an input. Also: routeTree.gen.ts (static.test.ts),
    // the registry record and the shipped skill (discovery and skill-parity tests), and the CLI
    // source, which onboarding.test.ts runs as a process (it imports the SDK under packages/*/src).
    "@starter/api-app#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/routeTree.gen.ts",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/server.json",
        "$TURBO_ROOT$/skills/starter/SKILL.md"
      ]
    },
    "@starter/api-app#test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/routeTree.gen.ts",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/server.json",
        "$TURBO_ROOT$/skills/starter/SKILL.md"
      ],
      "outputs": ["coverage/**"]
    },
    // apps/web's tests import packages/auth/src/access.ts and packages/api/src/headers.ts (see above).
    "@starter/web#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**"]
    },
    "@starter/web#test:coverage": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**"],
      "outputs": ["coverage/**"]
    },
    // sdk's schema.test.ts checks the generated client against the API's committed contract. The SDK
    // does not depend on apps/api, so nothing in its hash would see openapi.json change.
    "@starter/sdk#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/openapi.json"]
    }
  }
}
