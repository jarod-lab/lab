    "/v1/api-keys": {
      "post": {
        "operationId": "create_api_key",
        "summary": "Create an organization API key",
        "description": "Creates an API key for the caller's organization with the given permissions, which must be within the caller's own. The key is returned once; store it securely. Only a signed-in user (session or OAuth) can create keys, not another API key.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Unique key for this request. Retrying with the same key and body returns the first response; reusing it with a different body is a CONFLICT.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "What the key is for"
                  },
                  "permissions": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "description": "Permissions for the key, e.g. { \"project\": [\"read\"] }"
                  },
                  "expiresInDays": {
                    "description": "Omit for no expiry",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 365
                  }
                },
                "required": [
                  "name",
                  "permissions"
                ]
              },
              "example": {
                "name": "CI",
                "permissions": {
                  "project": [
                    "read"
                  ]
                },
                "expiresInDays": 90
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "permissions": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "id",
                    "key",
                    "permissions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or over quota. Wait for the Retry-After header before retrying.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          },
          {
            "bearer": []
          },
          {
            "oauth2": [
              "admin"
            ]
          }
        ],
        "x-required-permissions": [
          "apiKey:create"
        ]
      }
    },
    "/v1/agents": {
      "get": {
        "operationId": "list_connected_agents",
        "summary": "List the agents connected to this organization",
        "description": "Lists the organization's API keys and the OAuth clients (AI tools, CLIs) that hold consent or a live refresh token for it. Each has an id for revoke_agent_access. Use it to audit access before revoking. An OAuth client only shows while it holds a refresh token or consent.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "agents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "oauthClient",
                              "apiKey"
                            ]
                          },
                          "clientId": {
                            "description": "OAuth client id, as clientId on audit events; null for API keys",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "keyId": {
                            "description": "API key id, as actor.id on audit events; null for OAuth",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "name": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "lastUsedAt": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "access": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "type",
                          "clientId",
                          "keyId",
                          "name",
                          "createdAt",
                          "lastUsedAt",
                          "access"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "agents"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or over quota. Wait for the Retry-After header before retrying.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          },
          {
            "bearer": []
          },
          {
            "oauth2": [
              "admin"
            ]
          }
        ],
        "x-required-permissions": [
          "apiKey:delete"
        ],
        "x-agent-hints": {
          "readOnly": true,
          "idempotent": true
        }
      }
    },
    "/v1/agents/{id}": {
      "delete": {
        "operationId": "revoke_agent_access",
        "summary": "Revoke an agent's access to this organization",
        "description": "Deletes an API key, or for an OAuth client removes its consent and refresh tokens for this organization. Its tokens stop working immediately, including access tokens it already holds. The client itself is not deleted. Returns NOT_FOUND for ids that aren't connected to this organization. Confirm with the user before calling.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Agent id from list_connected_agents"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Unique key for this request. Retrying with the same key and body returns the first response; reusing it with a different body is a CONFLICT.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "revoked": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "revoked"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or over quota. Wait for the Retry-After header before retrying.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
